{
  "description": "Golden cases for the rule engine. 'facts' override these defaults: conditions=[diabetes,hypertension], max_missed_streak_critical=0, symptoms=[], symptom_severity_unknown_critical=false, glucose_latest=null, bp_sys_latest=null, bp_dia_latest=null, consecutive_no_response=0, intent_confidence_min=1.0, needs_human=false, medical_question=false. 'expect' is the SET of rule ids kept after family reduction.",
  "defaults": {
    "conditions": ["diabetes", "hypertension"],
    "max_missed_streak_critical": 0,
    "symptoms": [],
    "symptom_severity_unknown_critical": false,
    "glucose_latest": null,
    "bp_sys_latest": null,
    "bp_dia_latest": null,
    "consecutive_no_response": 0,
    "intent_confidence_min": 1.0,
    "needs_human": false,
    "medical_question": false
  },
  "cases": [
    { "name": "nothing reported", "facts": {}, "expect": [] },
    { "name": "chest pain", "facts": { "symptoms": ["chest_pain"] }, "expect": ["R-CRIT-SYM-01"] },
    { "name": "breathlessness plus swelling", "facts": { "symptoms": ["breathlessness", "leg_swelling"] }, "expect": ["R-CRIT-SYM-01", "R-SWELL-01"] },
    { "name": "unknown-severity critical flag (fail-safe)", "facts": { "symptom_severity_unknown_critical": true }, "expect": ["R-CRIT-SYM-01"] },
    { "name": "glucose 50 very low", "facts": { "glucose_latest": 50 }, "expect": ["R-GLU-LOW-02"] },
    { "name": "glucose 65 low", "facts": { "glucose_latest": 65 }, "expect": ["R-GLU-LOW-01"] },
    { "name": "glucose 70 boundary not low", "facts": { "glucose_latest": 70 }, "expect": [] },
    { "name": "glucose 249 not high", "facts": { "glucose_latest": 249 }, "expect": [] },
    { "name": "glucose 250 high", "facts": { "glucose_latest": 250 }, "expect": ["R-GLU-HIGH-01"] },
    { "name": "glucose 310 very high", "facts": { "glucose_latest": 310 }, "expect": ["R-GLU-HIGH-02"] },
    { "name": "sweating and shaking, no reading", "facts": { "symptoms": ["sweating_shaking"] }, "expect": ["R-HYPO-SYM-01"] },
    { "name": "sweating and glucose 48 keeps highest in family", "facts": { "symptoms": ["sweating_shaking"], "glucose_latest": 48 }, "expect": ["R-GLU-LOW-02"] },
    { "name": "sweating but hypertension only", "facts": { "symptoms": ["sweating_shaking"], "conditions": ["hypertension"] }, "expect": [] },
    { "name": "bp 150/95 below thresholds", "facts": { "bp_sys_latest": 150, "bp_dia_latest": 95 }, "expect": [] },
    { "name": "bp 162/90 high", "facts": { "bp_sys_latest": 162, "bp_dia_latest": 90 }, "expect": ["R-BP-HIGH-01"] },
    { "name": "bp 140/100 diastolic high", "facts": { "bp_sys_latest": 140, "bp_dia_latest": 100 }, "expect": ["R-BP-HIGH-01"] },
    { "name": "bp 186/110 severe", "facts": { "bp_sys_latest": 186, "bp_dia_latest": 110 }, "expect": ["R-BP-CRISIS-01"] },
    { "name": "bp 186/110 with severe headache", "facts": { "bp_sys_latest": 186, "bp_dia_latest": 110, "symptoms": ["severe_headache"] }, "expect": ["R-BP-CRISIS-02", "R-SYM-GEN-01"] },
    { "name": "bp 85/55 low", "facts": { "bp_sys_latest": 85, "bp_dia_latest": 55 }, "expect": ["R-BP-LOW-01"] },
    { "name": "bp 85/55 with dizziness", "facts": { "bp_sys_latest": 85, "bp_dia_latest": 55, "symptoms": ["dizziness"] }, "expect": ["R-BP-LOW-02", "R-SYM-GEN-02"] },
    { "name": "missed streak 1", "facts": { "max_missed_streak_critical": 1 }, "expect": [] },
    { "name": "missed streak 2", "facts": { "max_missed_streak_critical": 2 }, "expect": ["R-ADH-01"] },
    { "name": "missed streak 3", "facts": { "max_missed_streak_critical": 3 }, "expect": ["R-ADH-02"] },
    { "name": "HERO: missed x2 plus leg swelling", "facts": { "max_missed_streak_critical": 2, "symptoms": ["leg_swelling"] }, "expect": ["R-ADH-01", "R-COMBO-01"] },
    { "name": "leg swelling alone", "facts": { "symptoms": ["leg_swelling"] }, "expect": ["R-SWELL-01"] },
    { "name": "no response x2", "facts": { "consecutive_no_response": 2 }, "expect": ["R-NORESP-01"] },
    { "name": "no response x4", "facts": { "consecutive_no_response": 4 }, "expect": ["R-NORESP-02"] },
    { "name": "foot wound with diabetes", "facts": { "symptoms": ["foot_wound"] }, "expect": ["R-FOOT-01"] },
    { "name": "foot wound without diabetes", "facts": { "symptoms": ["foot_wound"], "conditions": ["hypertension"] }, "expect": [] },
    { "name": "needs human", "facts": { "needs_human": true }, "expect": ["R-UNCLEAR-01"] },
    { "name": "low confidence", "facts": { "intent_confidence_min": 0.4 }, "expect": ["R-UNCLEAR-01"] },
    { "name": "medical question", "facts": { "medical_question": true }, "expect": ["R-QUESTION-01"] },
    { "name": "fatigue minor", "facts": { "symptoms": ["fatigue"] }, "expect": ["R-SYM-GEN-02"] },
    { "name": "visual change moderate", "facts": { "symptoms": ["vision_change"] }, "expect": ["R-SYM-GEN-01"] },
    { "name": "multi: glucose 320 + chest pain + streak 3", "facts": { "glucose_latest": 320, "symptoms": ["chest_pain"], "max_missed_streak_critical": 3 }, "expect": ["R-CRIT-SYM-01", "R-GLU-HIGH-02", "R-ADH-02"] },
    { "name": "negated symptoms are absent from the fact", "facts": { "symptoms": [] }, "expect": [] }
  ]
}
