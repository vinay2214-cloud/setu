APP_ENV=development
DATABASE_URL=sqlite:///./setu.db
CORS_ORIGINS=["http://localhost:3000"]
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=
JWT_SECRET=local-demo-only-change-this-secret
SPEECH_PROVIDER=none
SARVAM_API_KEY=
CHANNEL_ADAPTER=simulator
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
DEMO_MODE=true
CLINIC_NAME=Demo Clinic
DEFAULT_TZ=Asia/Kolkata
LLM_TIMEOUT_S=8
SPEECH_TIMEOUT_S=6

# Optional first-run synthetic data bootstrap; used by scripts/dev.sh and Render
DEMO_AUTO_SEED=false
# Frontend calls the same-origin Next.js API proxy
API_PROXY_TARGET=http://127.0.0.1:8000
